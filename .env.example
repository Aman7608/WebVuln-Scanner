# Copy this file to .env and fill it in. NEVER commit the real .env file.

# Your domain (its DNS must point to this server). Use "localhost" to try it on your PC.
WEBVULN_DOMAIN=scanner.example.com
WEBVULN_PUBLIC_URL=https://scanner.example.com

# Long random secret. Create one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
WEBVULN_SECRET_KEY=replace-with-a-long-random-value

# Database login (the database is only reachable inside Docker)
POSTGRES_DB=webvuln
POSTGRES_USER=webvuln
POSTGRES_PASSWORD=replace-with-another-long-random-value

# Limits
WEBVULN_SCANS_PER_DAY=5
WEBVULN_RETENTION_DAYS=30
# 0 = only the first (admin) account can sign up
WEBVULN_REGISTRATION=1

# Ports Caddy listens on (change them only for a local test)
WEBVULN_HTTP_PORT=80
WEBVULN_HTTPS_PORT=443

# Optional: email when a scan finishes
WEBVULN_SMTP_HOST=
WEBVULN_SMTP_PORT=587
WEBVULN_SMTP_USER=
WEBVULN_SMTP_PASSWORD=
WEBVULN_SMTP_FROM=
